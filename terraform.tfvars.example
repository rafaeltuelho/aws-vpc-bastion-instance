# Copy to terraform.tfvars and fill in. See README.md for every parameter.
# The bastion always gets its own VPC; connect it to the cluster with peering/.

key_name   = "<ec2-key-pair>"
owner      = "<your-name>" # letters, digits, '-' and '_' only
aws_region = "us-east-2"

# --- Bastion VPC: set exactly one -------------------------------------------
create_vpc = true
vpc_cidr   = "10.255.0.0/24" # must not overlap the cluster VPC
# vpc_id   = "vpc-0123456789abcdef0" # existing client VPC, never the cluster's
