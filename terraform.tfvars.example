# Copy to terraform.tfvars and fill in. See README.md for every parameter.
# To connect the bastion to a cluster in another VPC, see peering/.

key_name   = "<ec2-key-pair>"
owner      = "<your-name>" # letters, digits, '-' and '_' only
aws_region = "us-east-2"

# --- Bastion VPC: set exactly one -------------------------------------------
create_vpc = true
vpc_cidr   = "10.255.0.0/24" # if you'll peer it, must not overlap the cluster VPC
# vpc_id              = "vpc-0123456789abcdef0" # existing VPC, e.g. the cluster's
# redpanda_cluster_id = "<byoc-cluster-id>"     # Redpanda BYOC cluster VPC
